{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlae.local/schemas/dataset/chat-record.schema.json",
  "title": "Dataset chat record",
  "description": "One line of chat.jsonl in the OpenAI chat fine-tuning format: the user's words plus the analysis summary, answered by a tool call against the registry.",
  "type": "object",
  "required": ["messages", "tools", "metadata"],
  "properties": {
    "messages": {
      "type": "array", "minItems": 3,
      "items": { "type": "object", "required": ["role"], "properties": { "role": { "enum": ["system", "user", "assistant"] } } }
    },
    "tools": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type", "function"] } },
    "metadata": { "type": "object", "required": ["decision", "project", "step_id"],
      "properties": { "spoken": { "$ref": "step-record.schema.json#/$defs/spoken" } } }
  }
}
