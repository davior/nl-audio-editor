{
  "id": "tilt",
  "version": 1,
  "title": "Tilt EQ",
  "summary": "Tilt the whole spectrum around a pivot: brighter (positive) or darker (negative) by so many dB per octave, capped. Static and zero-phase.",
  "category": "filters_eq",
  "class": "corrective",
  "tier": "on_demand",
  "scopes": ["clip", "time_range"],
  "params": [
    { "id": "db_per_octave", "title": "Tilt", "type": "number", "unit": "dB/octave", "min": -6, "max": 6, "step": 0.1, "required": true,
      "help": "Positive raises the highs and lowers the lows." },
    { "id": "pivot_hz", "title": "Pivot", "type": "number", "unit": "Hz", "min": 100, "max": 10000, "step": 10, "default": 1000,
      "help": "The frequency left unchanged." },
    { "id": "max_gain_db", "title": "Largest change", "type": "number", "unit": "dB", "min": 0, "max": 24, "step": 0.5, "default": 12 }
  ],
  "identity": [{ "db_per_octave": 0 }],
  "residual": "exact",
  "measurements": [
    { "id": "level_change_db", "title": "Level change", "unit": "dB" },
    { "id": "centroid_before_hz", "title": "Spectral centroid before", "unit": "Hz" },
    { "id": "centroid_after_hz", "title": "Spectral centroid after", "unit": "Hz" }
  ],
  "binding_hints": []
}
