{
  "id": "limiter",
  "version": 1,
  "title": "Limiter",
  "summary": "Always last in the chain: keeps every sample at or below the ceiling. Does nothing (bit-exact) when nothing exceeds it.",
  "category": "safety",
  "class": "safety",
  "system": true,
  "scopes": ["clip"],
  "params": [
    { "id": "ceiling_dbfs", "title": "Ceiling", "type": "number", "unit": "dBFS", "min": -20, "max": 0, "step": 0.1, "default": -1 },
    { "id": "lookahead_ms", "title": "Look-ahead", "type": "number", "unit": "ms", "min": 0.5, "max": 20, "step": 0.1, "default": 5 },
    { "id": "release_ms", "title": "Release", "type": "number", "unit": "ms", "min": 1, "max": 1000, "step": 1, "default": 50 }
  ],
  "identity": [],
  "residual": "exact",
  "measurements": [
    { "id": "max_reduction_db", "title": "Largest reduction", "unit": "dB" },
    { "id": "samples_limited", "title": "Samples reduced" }
  ],
  "binding_hints": []
}
